{
  "name": "hvac-concierge",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types server/src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --experimental-strip-types server/src/main.ts",
    "typecheck": "tsc --noEmit -p server && tsc --noEmit -p web"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@openai/agents": "0.8.5",
    "fastify": "^5.8.5",
    "openai": "^6.34.0",
    "twilio-agent-connect": "2.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@gtmi/strix-react": "0.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
