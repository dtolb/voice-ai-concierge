    "lastAction": "created",
    "spec": {
      "author": "SELF",
      "context": {
        "knowledge": {
          "enabled": false
        },
        "memory": {
          "enabled": true
        }
      },
      "description": "Extracts HVAC lead details and perceived purchase interest from a call.",
      "displayName": "HVAC Lead Qualification",
      "outputFormat": "JSON",
      "outputSchema": {
        "properties": {
          "addressConfirmed": {
            "type": "boolean"
          },
          "customerName": {
            "type": "string"
          },
          "nextStep": {
            "type": "string"
          },
          "purchaseInterest": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "purchaseInterestRationale": {
            "type": "string"
          },
          "reasonForCalling": {
            "type": "string"
          },
          "serviceAddress": {
            "type": "string"
          },
          "serviceType": {
            "enum": [
              "REPLACEMENT",
              "REPAIR",
              "MAINTENANCE",
              "INSTALLATION",
              "QUOTE",
              "OTHER",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "urgency": {
            "enum": [
              "EMERGENCY",
              "SOON",
              "FLEXIBLE",
              "UNKNOWN"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "prompt": "You analyze a phone call between a customer and the AI concierge of an HVAC (heating, ventilation and air conditioning) company.\n\nExtract the lead details the business needs to follow up:\n- customerName: the caller's full name as they gave it. Empty string if never given.\n- serviceAddress: the full service address (street, city, state, postal code) in one line. Empty string if never given.\n- addressConfirmed: true only if the agent read the address back and the caller agreed it was correct.\n- reasonForCalling: one sentence, in plain words, on why the customer called.\n- serviceType: the kind of work requested.\n- urgency: EMERGENCY if there is no heat or cooling in extreme weather, a gas smell, or a safety risk; SOON if they want it within days; FLEXIBLE otherwise.\n- purchaseInterest: how likely the caller is to buy. HIGH if they asked about pricing, financing or scheduling an install, or said they are ready to replace; MEDIUM if they are open but comparing options or want a quote first; LOW if they are only asking questions or pushing back on cost.\n- purchaseInterestRationale: one sentence quoting or paraphrasing what the caller said that supports the interest level.\n- nextStep: the follow-up the business should take, in one short sentence.\n\nUse UNKNOWN for an enum the conversation gives no evidence for. Never invent details the caller did not say."
    },
    "specHash": "4f582e3cfb3f31ba"
  },
